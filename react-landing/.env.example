# Copy to .env and fill in. Vite puts VITE_* values in the browser bundle,
# so use keys made for this purpose (see README.md).

# Hugging Face token for plain-English input. https://huggingface.co/settings/tokens
VITE_HF_ACCESS_TOKEN=

# Reown (WalletConnect) project id, for mobile wallets. Optional: without it,
# only browser wallets such as MetaMask are offered. https://cloud.reown.com
VITE_WALLETCONNECT_PROJECT_ID=

# Leave empty for RecoilPay's API. Only set it if we gave you another URL.
VITE_RECOILPAY_API_URL=
